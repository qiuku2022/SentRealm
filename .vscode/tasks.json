{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv:sync",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "ui:dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev:vite"],
      "options": {
        "cwd": "${workspaceFolder}/apps/gui",
        "env": {
          "BROWSER": "none"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*1420"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "sentrealm"
      }
    },
    {
      "label": "ui:build",
      "type": "shell",
      "command": "pnpm",
      "args": ["build:vite"],
      "options": {
        "cwd": "${workspaceFolder}/apps/gui"
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "cargo:build-debug",
      "type": "cargo",
      "command": "build",
      "options": {
        "cwd": "${workspaceFolder}/apps/gui/src-tauri"
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "tauri:debug-build",
      "dependsOn": ["cargo:build-debug", "ui:dev"],
      "dependsOrder": "parallel",
      "group": "build"
    },
    {
      "label": "pytest",
      "type": "shell",
      "command": "uv",
      "args": ["run", "pytest"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
