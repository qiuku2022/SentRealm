{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "apps.gui.api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "17300",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Desktop: 桌面前端 (断点模式)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "SENTREALM_SKIP_BACKEND_SPAWN": "1"
      }
    },
    {
      "name": "Desktop: 完整桌面 (免断点)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "compounds": [
    {
      "name": "▶ 桌面 + API 断点",
      "configurations": [
        "Python: FastAPI",
        "Desktop: 桌面前端 (断点模式)"
      ],
      "stopAll": true
    }
  ]
}
